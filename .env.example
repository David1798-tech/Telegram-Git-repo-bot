# Telegram
TELEGRAM_TOKEN=

# GitHub — needs "repo" scope
GITHUB_TOKEN=
GITHUB_USERNAME=

# Vercel (optional — only needed if you use /deploy vercel)
VERCEL_TOKEN=
VERCEL_DEPLOY_HOOK=
VERCEL_PROJECT_ID=

# Render (optional — only needed if you use /deploy render)
RENDER_API_KEY=
RENDER_DEPLOY_HOOK=
RENDER_SERVICE_ID=

# Security — comma-separated Telegram user IDs allowed to use the bot.
# Leave empty to allow anyone (not recommended for a bot with GitHub/deploy access).
ALLOWED_USER_IDS=
